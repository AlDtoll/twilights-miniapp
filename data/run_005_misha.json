    "incidents": [
      {
        "text": "Сети и лодки Невода обветшали, рыбаки недоловят",
        "done": false,
        "tags": [
          "#вред_2",
          "#мон638"
        ],
        "mon": 638
      },
      {
        "text": "Соляный Берег: ропот рыбаков и солеваров, староста Мирош ходит мрачен — народ ропщет на варягов в гарнизоне",
        "done": false,
        "tags": [
          "#вред",
          "#нелояльность",
          "#соляный_берег"
        ],
        "mon": 0
      },
      {
        "text": "Солончак: солевары варницы третьей плавки сговорились варить вполсилы — недосдача соли пошла на сторону",
        "done": false,
        "tags": [
          "#вред",
          "#нелояльность",
          "#солончак",
          "#солевары"
        ],
        "mon": 0
      },
      {
        "text": "Невод: рыбаки начали продавать улов в обход причала по тихим бухтам — обходят учёт",
        "done": false,
        "tags": [
          "#вред",
          "#нелояльность",
          "#невод"
        ],
        "mon": 0
      },
      {
        "text": "Солончак: главный чан третьей плавки треснул, рассол утекает в землю — солевары требуют замены сегодня же",
        "done": false,
        "tags": [
          "#вред",
          "#мон300",
          "#солевары",
          "#чан"
        ],
        "mon": 300
      },
      {
        "text": "Соляный Берег: спор за пустошь — варяг Хольд занял землю покойного купца, сын покойного претендует, ругань на торжке",
        "done": false,
        "tags": [
          "#земля",
          "#варяги"
        ],
        "mon": 0
      },
      {
        "text": "Невод: трое рыбаков отравились засолом из бракованной партии — слабые признаки той же «неправильной соли», что с Топи",
        "done": false,
        "tags": [
          "#вред",
          "#топь",
          "#вред"
        ],
        "mon": 0
      },
      {
        "text": "Соляный Берег: из казны пропали 150 мон, расходной книги нет, клерки разводят руками",
        "done": false,
        "tags": [
          "#вред",
          "#мон150",
          "#саботаж",
          "#казна"
        ],
        "mon": 150
      },
      {
        "text": "Солончак: ночной пожар в сарае соли — сгорело сырьё, искра или поджог",
        "done": false,
        "tags": [
          "#вред",
          "#мон100",
          "#саботаж",
          "#солончак"
        ],
        "mon": 100
      },
      {
        "text": "Невод: главный причал проседает, мостки гнилые — рыбаки рискуют, надо подложить лес",
        "done": false,
        "tags": [
          "#мон150",
          "#невод",
          "#починка"
        ],
        "mon": 150
      },
      {
        "text": "Соляный Берег: семья варягов сцепилась с местной — драка с увечьями, обе стороны просят княжьего суда",
        "done": false,
        "tags": [
          "#суд",
          "#варяги"
        ],
        "mon": 0
      },
      {
        "text": "Невод: на дальнем лове пропали двое рыбаков, лодка вернулась пустая, на дне — мокрая глина",
        "done": false,
        "tags": [
          "#вред",
          "#топь"
        ],
        "mon": 0
      },
      {
        "text": "Соляный Берег: гончар-местный жалуется на оброк, «при Хравне платили меньше», ремесленники начинают шептаться",
        "done": false,
        "tags": [
          "#ремёсла",
          "#ропот"
        ],
        "mon": 0
      }
    ],
    "visitors": [
      {
        "text": "Вольный корабельщик берётся починить шхуну и корвет — на будущее, не горит",
        "done": false,
        "tags": [
          "#возможность"
        ],
        "mon": 0
      },
      {
        "text": "Знахарка с болотного края просит защиты, сулит знание о Топи — не срочно",
